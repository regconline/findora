# ---------------------------------------------------------------
# Findora environment variables
# Copy to .env.local for development. In Vercel, add these under
# Project → Settings → Environment Variables. NEVER commit real values.
# ---------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonical URLs, sitemaps, emails and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER ONLY. Bypasses Row Level Security. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Resend (transactional email) — https://resend.com/api-keys
# Without a key, emails are logged to the server console instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="Findora <no-reply@findora.co.za>"
# Receives new-listing, report and contact-form notifications
ADMIN_NOTIFICATION_EMAIL=

# Salt for privacy-preserving visitor hashes in first-party analytics. Use a long random string.
ANALYTICS_SALT=change-me-to-a-long-random-string

# Google Analytics 4 (optional; loads only after visitor consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token (optional; or verify via DNS)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google AdSense — keep disabled until your account and domain are approved
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Cloudflare Turnstile CAPTCHA (optional; enables bot protection on registration, enquiries, contact)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
